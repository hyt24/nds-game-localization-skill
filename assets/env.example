# Select manual, local, or hybrid. Do not commit the resulting .env.
NDS_LOCALIZATION_MODE=manual

# Optional local OCR commands/models.
VISION_OCR_COMMAND=
MANGA_OCR_COMMAND=
MANGA_OCR_MODEL=

# Optional provider-neutral translation settings.
TRANSLATION_PROVIDER=
TRANSLATION_MODEL=
TRANSLATION_API_BASE=
TRANSLATION_API_KEY=

# Optional vision API for image OCR when local OCR is insufficient.
VISION_PROVIDER=
VISION_MODEL=
VISION_API_BASE=
VISION_API_KEY=
